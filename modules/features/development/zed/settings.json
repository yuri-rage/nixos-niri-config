// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "file_types": {
    "Lua": ["luau", "*.luau"],
  },
  "buffer_font_weight": 300.0,
  "buffer_font_family": "MesloLGS Nerd Font",
  "terminal": {
    "font_size": 14.0,
    "font_family": "FiraCode Nerd Font",
  },
  "agent": {
    "default_width": 320.0,
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "project_panel": {
    "dock": "left",
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Mocha",
    "dark": "Catppuccin Macchiato",
  },
  "ui_font_size": 16,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Mocha",
  },
  "languages": {
    "Python": {
      "language_servers": [
        "ruff",
        "basedpyright"
      ]
    }
  },
  "lsp": {
    "nil": {
      "settings": {
        "nix": {
          "flake": {
            "autoArchive": true,
          },
        },
      },
    },
    "ruff": {
      "binary": {
        "path": "ruff",
        "arguments": [
          "server"
        ]
      }
    },
    "basedpyright": {
      "binary": {
        "path": "basedpyright-langserver",
        "arguments": [
          "--stdio"
        ]
      }
    }
  }
}
